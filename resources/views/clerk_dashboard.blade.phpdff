    {{-- SCRIPTS --}}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const regRadio = document.getElementById('type_regular');
            const newRadio = document.getElementById('type_new');
            const regSec = document.getElementById('regular_patient_section');
            const newSec = document.getElementById('new_patient_section');
            
            function togglePatientInputs() {
                if (regRadio.checked) {
                    regSec.classList.remove('hidden');
                    newSec.classList.add('hidden');
                } else {
                    regSec.classList.add('hidden');
                    newSec.classList.remove('hidden');
                }
            }
            
            regRadio.addEventListener('change', togglePatientInputs);
            newRadio.addEventListener('change', togglePatientInputs);

            window.filterQueueByDoctor = function(docName, el) {
                const items = document.querySelectorAll('.queue-item');
                const cards = document.querySelectorAll('.doctor-card');
                const indicator = document.getElementById('filter-indicator');

                const isActive = el.classList.contains('bg-[#8CB1C3]');

                // Reset all cards
                cards.forEach(c => {
                    c.classList.remove('bg-[#8CB1C3]', 'border-[#8CB1C3]', 'text-white');
                    c.classList.add('bg-white', 'border-white');
                    const nameTag = c.querySelector('.doctor-name');
                    if(nameTag) nameTag.classList.remove('text-white');
                });

                if(!isActive) {
                    el.classList.remove('bg-white', 'border-white');
                    el.classList.add('bg-[#8CB1C3]', 'border-[#8CB1C3]', 'text-white');
                    const nameTag = el.querySelector('.doctor-name');
                    if(nameTag) nameTag.classList.add('text-white');

                    indicator.classList.remove('hidden');
                    indicator.innerText = `Viewing Dr. ${docName}`;

                    items.forEach(i => {
                        i.style.display = (i.dataset.doctorName === docName) ? 'flex' : 'none';
                    });
                } else {
                    indicator.classList.add('hidden');
                    items.forEach(i => i.style.display = 'flex');
                }
            }
        });
    </script>
</x-app-layout>